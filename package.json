{
    "name": "afron-workspace",
    "version": "1.0.0",
    "repository": "https://github.com/hve4638/ai-front.git",
    "author": "Hve <hve4638@gmail.com>",
    "license": "GPL-3.0-only",
    "scripts": {
        "dev": "pnpm app:dev",
        "app:dev": "concurrently \"pnpm _electron:dev\" \"pnpm _front:dev\"",
        "web:dev": "concurrently \"pnpm --filter @afron/web dev\" \"pnpm --filter @afron/frontend dev:web\"",
        "_front:dev": "pnpm --filter @afron/frontend start",
        "_front:build": "pnpm --filter @afron/frontend build",
        "_electron:dev": "pnpm rebuild:electron && wait-on http://localhost:8536 && pnpm --filter @afron/electron start",
        "_electron:build": "pnpm --filter @afron/electron build",
        "_electron:load_static": "cd packages/electron && powershell -ExecutionPolicy Bypass -File ./import-static.ps1",
        "_electron:dist": "pnpm --filter @afron/electron dist:win",
        "_web:build": "pnpm --filter @afron/web build",
        "_core:build": "pnpm --filter @afron/core build",
        "_chatai:build": "pnpm --filter @afron/chatai-models build",
        "build": "pnpm _chatai:build && pnpm _core:build && pnpm _electron:build && pnpm _front:build",
        "dist": "pnpm build && pnpm _electron:load_static && pnpm rebuild:electron && pnpm _electron:dist",
        "rebuild:electron": "pnpm --filter @afron/electron electron-rebuild",
        "clean": "pnpm clean:modules",
        "clean:modules": "powershell -ExecutionPolicy Bypass -File ./scripts/remove-install.ps1",
        "clean:dist": "powershell -ExecutionPolicy Bypass -File ./scripts/remove-dist.ps1",
        "reinstall": "pnpm clean:modules && pnpm install"
    },
    "devDependencies": {
        "concurrently": "^9.0.1",
        "cross-env": "^7.0.3",
        "wait-on": "^8.0.1"
    },
    "private": true,
    "workspaces": {
        "packages": [
            "packages/*"
        ]
    },
    "pnpm": {
        "overrides": {
            "node-abi": "4.26.0"
        },
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "@tailwindcss/oxide",
            "better-sqlite3",
            "electron",
            "electron-winstaller",
            "esbuild",
            "sharp"
        ],
        "patchedDependencies": {
            "lazystream@1.0.1": "patches/lazystream@1.0.1.patch"
        }
    }
}